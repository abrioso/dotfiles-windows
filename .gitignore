### Git Ignore File ###

# Exclude .vscode folder
.vscode/

# Exclude all the logs
logs/*.txt

# Exclude test results
tests/*.results.json

# Local machine-specific dotfiles configuration
dotfiles-configurations/*.json
!dotfiles-configurations/*.json.example

# Windows Terminal settings are created from the base template and kept machine-local
windows-terminal-settings/
!windows-terminal-settings/README.md

# Private PowerShell profile extension
powershell-profiles/extra.ps1
