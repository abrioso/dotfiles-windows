* text=auto

# Explicit EOL rules
# Keep JSON, Markdown and shell scripts with LF in working tree
*.json text eol=lf
*.json.example text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# PowerShell scripts: prefer CRLF on Windows working trees
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Windows Terminal settings live in dotfiles-configurations/ as a
# gitignored local file generated from windows-terminal-settings.json.example;
# no tracked path needs an explicit EOL rule for it.

# Ensure attributes file itself uses LF in repo
.gitattributes text eol=lf

# Treat common binary formats as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
